# Copy this file to .env and adjust the values. Never commit .env.

# Any OpenAI-compatible server. Ollama serves one at /v1 on port 11434.
LLM_BASE_URL=http://localhost:11434/v1
# Must be a model you have pulled with `ollama pull <name>` and that supports tool calling.
LLM_MODEL=your-model-name
# Ollama ignores the key, but the OpenAI SDK requires a non-empty value.
LLM_API_KEY=ollama

# Sampling. Temperature 0-2 (lower = more deterministic), top_p 0-1.
LLM_TEMPERATURE=0.2
LLM_TOP_P=1.0
LLM_REQUEST_TIMEOUT_SECONDS=120

# Oldest turns are dropped beyond this many messages (system prompt is always kept).
MAX_HISTORY_MESSAGES=20

LOG_LEVEL=INFO
LOG_FILE=logs/app.log
SHOW_TOKEN_USAGE=true
